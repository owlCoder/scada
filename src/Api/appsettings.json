{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Security": {
    "CommandApiKey": "",
    "ApiKeys": {
      "Enabled": true
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Authentication": {
    "Oidc": {
      "Enabled": false
    }
  },
  "Observability": {
    "JsonLogs": false,
    "OtlpEndpoint": ""
  }
}
