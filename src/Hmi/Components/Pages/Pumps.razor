@page "/pumps"
@inherits RealtimeComponentBase
@inject ControlCommandService Commands

<PageTitle>Pumps · SCADA</PageTitle>
<RefreshErrorBanner Error="@RefreshError" />
<h1>Pumps</h1>
<OutcomeBanner Outcome="_outcome" />

<table class="grid">
    <thead>
        <tr><th>Pump</th><th>State</th><th>Mode</th><th>Speed</th><th>Flow</th><th>Pressure</th><th>Health</th><th>Interlock</th>
            @if (Session.CanOperate) { <th>Commands</th> }</tr>
    </thead>
    <tbody>
        @foreach (var pump in _plant.Pumps)
        {
            <tr>
                <td><strong class="cell-title">@pump.Id</strong> @pump.Name</td>
                <td><StatusPill Text="@pump.State.ToString()" Kind="@(pump.State == PumpState.Running ? "ok" : "neutral")" /></td>
                <td>@pump.Mode</td>
                <td>@pump.Speed.ToString("0", CultureInfo.InvariantCulture) %</td>
                <td>@pump.FlowRate.ToString("0.00", CultureInfo.InvariantCulture) m³/min</td>
                <td>@pump.DischargePressure.ToString("0.0", CultureInfo.InvariantCulture) bar</td>
                <td><StatusPill Text="@(pump.Fault == PumpFault.None ? pump.Health.ToString() : pump.Fault.ToString())"
                                Kind="@HealthKind(pump.Health)" /></td>
                <td>@(pump.InterlockReason ?? "—")</td>
                @if (Session.CanOperate)
                {
                    <td class="actions-cell">
                        <button class="btn" @onclick="() => Ask(pump, OperatorCommandType.StartPump)">Start</button>
                        <button class="btn" @onclick="() => Ask(pump, OperatorCommandType.StopPump)">Stop</button>
                        <button class="btn" @onclick="() => Ask(pump, pump.Mode == ControlMode.Manual
                            ? OperatorCommandType.SetAutomatic : OperatorCommandType.SetManual)">
                            @(pump.Mode == ControlMode.Manual ? "Automatic" : "Manual")
                        </button>
                        @if (pump.InterlockReason is not null)
                        {
                            <button class="btn" @onclick="() => Ask(pump, OperatorCommandType.ResetInterlock)">Reset interlock</button>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
<p class="muted">Commands in automatic mode are rejected: switch the pump to manual first.</p>
<ConfirmDialog Pending="_pending" Completed="OnCompletedAsync" />

@code {
    private PlantSnapshot _plant = default!;
    private PendingAction? _pending;
    private ActionOutcome? _outcome;

    protected override IReadOnlyCollection<string> Topics => [RealtimeTopics.Plant];

    protected override bool Refresh()
    {
        _plant = Session.Plant();
        return true;
    }

    private bool Ask(PumpSnapshot pump, OperatorCommandType type)
    {
        _pending = new PendingAction($"{Describe(type)} {pump.Id}?", $"{Describe(type)} {pump.Name} ({pump.Id}). This changes the live process.",
            () => Task.FromResult(ActionOutcome.From(Commands.Execute(
                new OperatorCommand(pump.Id, type, null, CommandSource.Hmi), Session.Actor))),
            Dangerous: type is OperatorCommandType.StartPump or OperatorCommandType.StopPump);
        return true;
    }

    private async Task OnCompletedAsync(ActionOutcome? outcome)
    {
        _pending = null;
        _outcome = outcome ?? _outcome;
        await RefreshNowAsync();
    }

    private static string Describe(OperatorCommandType type) => type switch
    {
        OperatorCommandType.StartPump => "Start",
        OperatorCommandType.StopPump => "Stop",
        OperatorCommandType.SetManual => "Switch to manual:",
        OperatorCommandType.SetAutomatic => "Switch to automatic:",
        OperatorCommandType.ResetInterlock => "Reset interlock of",
        _ => type.ToString()
    };

    private static string HealthKind(DeviceHealth health) => health switch
    {
        DeviceHealth.Healthy => "ok",
        DeviceHealth.Warning => "warn",
        _ => "alarm"
    };
}
