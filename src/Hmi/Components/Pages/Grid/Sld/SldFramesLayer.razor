@using Hmi.Services.Grid.Sld
@* Substation frames: subtle dashed rectangles grouping the anchors of the elements one RTU measures/controls.
   The station name is a small-caps label in the top-left corner OUTSIDE the frame and appears from the medium LOD
   up. Pure static geometry — this layer only re-renders when the definition, visibility or LOD changes. *@

@if (Show)
{
    @foreach (var frame in Model.Frames)
    {
        <g class="sld-frame" data-rtu="@frame.RtuId">
            <rect x="@N(frame.X)" y="@N(frame.Y)" width="@N(frame.Width)" height="@N(frame.Height)" rx="6" />
            @if (Lod >= SldLod.Medium)
            {
                <g transform="translate(@N(frame.X) @N(frame.Y - 7)) scale(@N(LabelScale))">
                    <text class="sld-frame-name" x="0" y="0">@frame.Name</text>
                </g>
            }
        </g>
    }
}

@code {
    [Parameter, EditorRequired] public SldStaticModel Model { get; set; } = default!;
    [Parameter] public bool Show { get; set; } = true;
    [Parameter] public SldLod Lod { get; set; }
    [Parameter] public double LabelScale { get; set; } = 1;

    private SldStaticModel? _rendered;
    private bool _renderedShow;
    private SldLod _renderedLod;
    private double _renderedScale;

    protected override bool ShouldRender() =>
        !ReferenceEquals(Model, _rendered) || Show != _renderedShow || Lod != _renderedLod || LabelScale != _renderedScale;

    protected override void OnAfterRender(bool firstRender)
    {
        _rendered = Model;
        _renderedShow = Show;
        _renderedLod = Lod;
        _renderedScale = LabelScale;
    }

    private static string N(double value) => value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}
