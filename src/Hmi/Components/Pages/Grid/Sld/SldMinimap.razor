@using Hmi.Services.Grid.Sld
@using Domain.Grid.Definition
@using System.Globalization
@inject IJSRuntime JS
@implements IAsyncDisposable
@* Minimap (bottom-left overlay): the whole network in miniature with the current viewport rectangle.
   Click/drag navigates. Client→map conversion uses the JS module when available; without it the fixed
   200×130 px box at the origin is assumed (also what the tests use). *@

<div class="sld-minimap-wrap">
    <svg class="sld-minimap" viewBox="@ViewBox" preserveAspectRatio="none" aria-label="Minimap — click or drag to navigate"
         @ref="_svg" @onpointerdown="Down" @onpointermove="Move" @onpointerup="Up" @onpointercancel="Up">
        @foreach (var frame in Model.Frames)
        {
            <rect class="mm-frame" x="@N(frame.X)" y="@N(frame.Y)" width="@N(frame.Width)" height="@N(frame.Height)" />
        }
        @foreach (var element in Model.Elements)
        {
            @foreach (var wire in element.Wires)
            {
                <polyline class="mm-wire" points="@Points(wire)" />
            }
        }
        @foreach (var bus in Model.Elements.Where(e => e.Kind == SldElementKind.Bus))
        {
            <circle class="mm-bus @SldVoltage.Class(bus.VoltageKv)" cx="@N(bus.Anchor.X)" cy="@N(bus.Anchor.Y)" r="7" />
        }
        <rect class="mm-view" x="@N(ViewX)" y="@N(ViewY)" width="@N(ViewW)" height="@N(ViewH)" />
    </svg>
</div>

@code {
    [Parameter, EditorRequired] public SldStaticModel Model { get; set; } = default!;
    [Parameter, EditorRequired] public SldViewport Viewport { get; set; } = default!;
    [Parameter] public EventCallback<(double Fx, double Fy)> OnNavigate { get; set; }

    private ElementReference _svg;
    private IJSObjectReference? _module;
    private bool _navigating;

    private SldBounds Bounds => Model.Bounds;
    private string ViewBox => string.Create(CultureInfo.InvariantCulture, $"{N(Bounds.X)} {N(Bounds.Y)} {N(Bounds.Width)} {N(Bounds.Height)}");
    private double ViewX => Math.Max(Bounds.X, Viewport.X);
    private double ViewY => Math.Max(Bounds.Y, Viewport.Y);
    private double ViewW => Math.Min(Bounds.Right, Viewport.X + Viewport.Width) - ViewX;
    private double ViewH => Math.Min(Bounds.Bottom, Viewport.Y + Viewport.Height) - ViewY;

    private async Task Down(PointerEventArgs e)
    {
        _navigating = true;
        await CaptureAsync(e.PointerId);
        await NavigateAsync(e.ClientX, e.ClientY);
    }

    private async Task Move(PointerEventArgs e)
    {
        if (_navigating)
            await NavigateAsync(e.ClientX, e.ClientY);
    }

    private async Task Up(PointerEventArgs e)
    {
        _navigating = false;
        await ReleaseAsync(e.PointerId);
    }

    private async Task NavigateAsync(double clientX, double clientY)
    {
        var (fx, fy) = await FractionAsync(clientX, clientY);
        await OnNavigate.InvokeAsync((fx, fy));
    }

    private async Task<(double Fx, double Fy)> FractionAsync(double clientX, double clientY)
    {
        var module = await ModuleAsync();
        if (module is not null)
        {
            try
            {
                var p = await module.InvokeAsync<DiagramPosition>("point", _svg, clientX, clientY);
                if (Bounds.Width > 0 && Bounds.Height > 0)
                    return ((p.X - Bounds.X) / Bounds.Width, (p.Y - Bounds.Y) / Bounds.Height);
            }
            catch (Exception)
            {
                // fall through to the fixed-size fallback below
            }
        }
        return (clientX / 200, clientY / 130);
    }

    private async Task<IJSObjectReference?> ModuleAsync()
    {
        if (_module is not null)
            return _module;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Hmi/js/sld.js");
        }
        catch (Exception)
        {
            return null; // tests / prerender: fall back to the fixed-size box
        }
        return _module;
    }

    private async Task CaptureAsync(long pointerId)
    {
        var module = await ModuleAsync();
        if (module is not null)
        {
            try { await module.InvokeAsync<bool>("capture", _svg, pointerId); }
            catch (Exception) { }
        }
    }

    private async Task ReleaseAsync(long pointerId)
    {
        var module = await ModuleAsync();
        if (module is not null)
        {
            try { await module.InvokeAsync<bool>("release", _svg, pointerId); }
            catch (Exception) { }
        }
    }

    private static string Points(IReadOnlyList<DiagramPosition> wire) => string.Join(' ', wire.Select(p => $"{N(p.X)},{N(p.Y)}"));
    private static string N(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        GC.SuppressFinalize(this);
    }
}
