@using Hmi.Services.Grid.Sld
@using Domain.Grid.Definition
@using System.Globalization
@* One diagram element: wires, symbol, flow arrow, markers, LOD labels and (at high zoom) its value box.
   ShouldRender compares the immutable state records so a realtime tick only re-renders changed elements. *@

<g class="sld-el kind-@KindCss @GroupClass" data-id="@Element.Id" data-kind="@KindCss"
   role="button" tabindex="-1" aria-label="@Aria"
   @onclick="SelectAsync" @onclick:stopPropagation
   @ondblclick="OpenAsync" @ondblclick:stopPropagation
   @oncontextmenu="MenuAsync" @oncontextmenu:preventDefault @oncontextmenu:stopPropagation
   @onpointerdown:stopPropagation
   @onpointerover="HoverAsync" @onpointerout="UnhoverAsync">
    @foreach (var wire in Element.Wires)
    {
        <polyline class="sld-wire @VoltageClass @WireClass" points="@Points(wire)" />
    }
    <g transform="@AnchorTransform">
        <g transform="scale(@N(Scales.Symbol))">
            @if (State?.Selected == true)
            {
                <circle class="sld-halo" r="27" />
            }
            <SldSymbol Kind="Element.Kind" SwitchKind="Element.SwitchKind" Closed="State?.Closed" />
            @if (State?.Invalid == true)
            {
                <g><text class="sld-qmark" x="16" y="-12">?</text></g>
            }
            @if (State?.HasFlow == true && Element.Wires.Count > 0)
            {
                var (point, angle) = SldPathMath.PointAt(Element.Wires[0], 0.5);
                @* The arrow sits inside the element group translated to the anchor, so use anchor-relative coordinates. *@
                <path class="sld-flow" transform="translate(@N(point.X - Element.Anchor.X) @N(point.Y - Element.Anchor.Y)) rotate(@N(State.FlowFrom ? angle : angle + 180))" d="M7,0 L-5,-4.5 L-5,4.5 Z" />
            }
            @if (State is not null)
            {
                @if (State.ProtectionTripped)
                {
                    <g class="sld-marker sld-protection" transform="translate(-26 -30)" role="img" aria-label="Protection tripped">
                        <title>Protection tripped</title><path d="M0,0 L0,-11 L9,-8 L0,-5 Z" /><text y="7" text-anchor="middle">P</text>
                    </g>
                }
                @if (State.AlarmSeverity is { } severity)
                {
                    <g class="sld-marker sld-alarm @State.AlarmClass @(State.AlarmUnacknowledged ? "blink-unack" : "")" transform="translate(26 -30)" role="img" aria-label="Active alarm @severity">
                        <title>Active alarm (@severity)</title><path d="M-5,3 L-3.5,-3 A4.5,4.5 0 0 1 3.5,-3 L5,3 Z" /><circle cy="5.5" r="1.6" />
                    </g>
                }
                var tags = State.Tags;
                @for (var i = 0; i < tags.Count; i++)
                {
                    var tag = tags[i];
                    <g class="sld-marker sld-tag tag-@TagClass(tag.Kind)" transform="translate(-36 @(20 + i * 20))" role="img" aria-label="@TagLabel(tag)">
                        <title>@TagLabel(tag): @tag.Reason</title>
                        <rect x="0" y="0" width="34" height="16" rx="3" />
                        @if (tag.Kind == GridTagKind.Earthed)
                        {
                            <path class="tag-glyph" d="M17,3 L17,9 M12,6 L22,6 M14,8.5 L20,8.5 M15.5,11 L18.5,11" />
                        }
                        else
                        {
                            <g><text x="17" y="12" text-anchor="middle">@TagText(tag.Kind)</text></g>
                        }
                    </g>
                }
            }
        </g>
        @if (Lod == SldLod.Low && (Element.Kind == SldElementKind.Bus || Element.Kind == SldElementKind.Line))
        {
            <g transform="translate(14 -14) scale(@N(Scales.Id))"><text class="sld-lod-id" x="0" y="0">@Element.Id</text></g>
        }
        else if (Lod >= SldLod.Medium)
        {
            <g transform="translate(16 -14) scale(@N(Scales.Label))"><text class="sld-lod-name" x="0" y="0">@Element.Name</text></g>
        }
    </g>
    @if (Lod == SldLod.High && Placement is not null && State?.ValueText is { } value)
    {
        @* Thin leader line back to the element when the box had to be displaced from its symbol. *@
        @if (Placement.Displaced)
        {
            <line class="sld-leader" x1="@N(Element.Anchor.X)" y1="@N(Element.Anchor.Y)"
                  x2="@N(Placement.X + ValueWidth * Scales.Value / 2)" y2="@N(Placement.Y + 9 * Scales.Value)" />
        }
        <g class="sld-value" transform="translate(@N(Placement.X) @N(Placement.Y)) scale(@N(Scales.Value))">
            <rect width="@N(ValueWidth)" height="18" rx="3" />
            <text x="6" y="13">@value</text>
            @if (State.QualityFlag is { } flag)
            {
                <g><text class="sld-qflag q-@flag.ToLowerInvariant()" x="@N(ValueWidth - 12)" y="13">@flag</text></g>
            }
        </g>
    }
    else if (Lod < SldLod.High && Placement is not null && State?.KeyText is { } key)
    {
        @* Compact key value (bus kV, branch A·%) at a constant on-screen size, placed collision-free. *@
        @if (Placement.Displaced)
        {
            <line class="sld-leader" x1="@N(Element.Anchor.X)" y1="@N(Element.Anchor.Y)"
                  x2="@N(Placement.X + KeyWidth * Scales.Value / 2)" y2="@N(Placement.Y + 9 * Scales.Value)" />
        }
        <g class="sld-key" transform="translate(@N(Placement.X) @N(Placement.Y)) scale(@N(Scales.Value))">
            <text x="3" y="13">@key</text>
        </g>
    }
    @if (Lod == SldLod.High && TapPlacement is not null && Tap is { } tap)
    {
        @* Tap position to the right of the transformer symbol, in the same value-box style, placed collision-free. *@
        @if (TapPlacement.Displaced)
        {
            <line class="sld-leader" x1="@N(Element.Anchor.X)" y1="@N(Element.Anchor.Y)"
                  x2="@N(TapPlacement.X + TapWidth * Scales.Value / 2)" y2="@N(TapPlacement.Y + 9 * Scales.Value)" />
        }
        <g class="sld-value sld-tap-box" transform="translate(@N(TapPlacement.X) @N(TapPlacement.Y)) scale(@N(Scales.Value))">
            <rect width="@N(TapWidth)" height="18" rx="3" />
            <text x="6" y="13">tap @tap</text>
        </g>
    }
</g>

@code {
    [Parameter, EditorRequired] public SldElement Element { get; set; } = default!;
    [Parameter] public SldElementState? State { get; set; }
    [Parameter] public SldLod Lod { get; set; }
    [Parameter] public SldViewMode ViewMode { get; set; }
    [Parameter] public bool ShowHeat { get; set; }
    [Parameter] public SldLabelPlacement? Placement { get; set; }
    [Parameter] public SldLabelPlacement? TapPlacement { get; set; }
    [Parameter] public SldScales Scales { get; set; } = new(1, 1, 1, 1);
    [Parameter] public int? Tap { get; set; }
    [Parameter] public EventCallback<string> OnSelect { get; set; }
    [Parameter] public EventCallback<string> OnOpenControl { get; set; }
    [Parameter] public EventCallback<SldPointerRequest> OnContextMenu { get; set; }
    [Parameter] public EventCallback<SldPointerRequest> OnHover { get; set; }
    [Parameter] public EventCallback<string> OnUnhover { get; set; }

    // Signature of the last render; a realtime tick only re-renders elements whose state actually changed.
    private SldElementState? _renderedState;
    private SldLod _renderedLod;
    private SldViewMode _renderedMode;
    private bool _renderedHeat;
    private SldLabelPlacement? _renderedPlacement;
    private SldLabelPlacement? _renderedTapPlacement;
    private SldScales _renderedScales = new(1, 1, 1, 1);
    private int? _renderedTap;

    protected override bool ShouldRender() =>
        !Equals(State, _renderedState) || Lod != _renderedLod || ViewMode != _renderedMode || ShowHeat != _renderedHeat
        || !Equals(Placement, _renderedPlacement) || !Equals(TapPlacement, _renderedTapPlacement)
        || !Equals(Scales, _renderedScales) || Tap != _renderedTap;

    protected override void OnAfterRender(bool firstRender)
    {
        _renderedState = State;
        _renderedLod = Lod;
        _renderedMode = ViewMode;
        _renderedHeat = ShowHeat;
        _renderedPlacement = Placement;
        _renderedTapPlacement = TapPlacement;
        _renderedScales = Scales;
        _renderedTap = Tap;
    }

    private string KindCss => Element.Kind.ToString().ToLowerInvariant();
    private string VoltageClass => SldVoltage.Class(Element.VoltageKv);
    private string AnchorTransform => $"translate({N(Element.Anchor.X)} {N(Element.Anchor.Y)})";
    private string GroupClass
    {
        get
        {
            var classes = new List<string> { VoltageClass };
            if (State is null) return string.Join(' ', classes);
            if (!State.Energized) classes.Add("is-dead");
            if (State.Invalid) classes.Add("is-invalid");
            if (State.Closed == true) classes.Add("closed");
            if (State.Closed == false) classes.Add("open");
            if (State.Selected) classes.Add("is-selected");
            return string.Join(' ', classes);
        }
    }
    private string WireClass
    {
        get
        {
            if (State is null) return "";
            var classes = new List<string>();
            if (!State.Energized) classes.Add("is-dead");
            classes.Add(State.LoadingClass);
            return string.Join(' ', classes);
        }
    }
    private string Aria => State is null
        ? $"{Element.Name}, {Element.Kind}, {Element.Id}"
        : $"{Element.Name}, {Element.Kind}, {Element.Id}, {(State.Closed is { } c ? (c ? "closed" : "open") : State.Energized ? "energized" : "de-energised")}, {State.ValueText ?? "no value"}";
    private double ValueWidth => SldLabelPlacer.BoxSize(State?.ValueText, State?.QualityFlag).Width;
    private double KeyWidth => SldLabelPlacer.BoxSize(State?.KeyText, null).Width;
    private double TapWidth => SldLabelPlacer.BoxSize(Tap is { } t ? $"tap {t}" : null, null).Width;

    private static string Points(IReadOnlyList<DiagramPosition> wire) => string.Join(' ', wire.Select(p => $"{N(p.X)},{N(p.Y)}"));
    private static string N(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private static string TagClass(GridTagKind kind) => kind switch
    {
        GridTagKind.DoNotOperate => "dno",
        GridTagKind.Earthed => "earthed",
        GridTagKind.WorkInProgress => "wip",
        _ => "info"
    };
    private static string TagText(GridTagKind kind) => kind switch
    {
        GridTagKind.DoNotOperate => "DNO",
        GridTagKind.WorkInProgress => "WIP",
        GridTagKind.Information => "i",
        _ => "⏚"
    };
    private static string TagLabel(GridTag tag) => $"{tag.Kind} tag";

    private Task SelectAsync() => OnSelect.InvokeAsync(Element.Id);
    private Task OpenAsync() => OnOpenControl.InvokeAsync(Element.Id);
    private Task MenuAsync(MouseEventArgs e) => OnContextMenu.InvokeAsync(new SldPointerRequest(Element.Id, e.ClientX, e.ClientY));
    private Task HoverAsync(PointerEventArgs e) => OnHover.InvokeAsync(new SldPointerRequest(Element.Id, e.ClientX, e.ClientY));
    private Task UnhoverAsync(PointerEventArgs e) => OnUnhover.InvokeAsync(Element.Id);
}
