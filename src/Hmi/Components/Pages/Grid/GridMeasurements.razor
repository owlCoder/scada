@page "/grid/measurements"
@inherits GridPageBase
<PageTitle>Grid measurements · SCADA</PageTitle>
<h1>RTU measurements</h1>
<GridPageStatus Error="@RefreshError" Available="@(Snapshot is not null)" />
@if (Snapshot is { } grid)
{
    <table class="grid"><thead><tr><th>Measurement</th><th>Element</th><th>RTU</th><th>Kind</th><th>Reported</th><th>Quality</th>
        @if (Session.IsInstructor) { <th>True value</th><th>Spoofed</th> }</tr></thead><tbody>
    @foreach (var item in grid.Measurements)
    {
        <tr><td>@item.Id</td><td>@item.ElementId</td><td>@item.RtuId</td><td>@item.Kind</td><td>@Number(item.ReportedValue) @item.Unit</td><td>@item.Quality</td>
            @if (Session.IsInstructor) { <td>@Number(item.TrueValue) @item.Unit</td><td>@(item.IsSpoofed ? "Yes" : "No")</td> }</tr>
    }
    </tbody></table>
}
