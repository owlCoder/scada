@page "/grid/editor"
@attribute [Authorize(Policy = "Administrator")]
@inherits GridPageBase
@inject GridEquipmentCatalog Catalog
@inject IJSRuntime JS
@using Microsoft.Extensions.DependencyInjection

<PageTitle>Network editor · SCADA</PageTitle>
<h1>Network editor</h1>
@if (!Session.IsInstructor)
{
    <AccessDenied />
}
else
{
    <RefreshErrorBanner Error="@RefreshError" />
    <OutcomeBanner Outcome="Outcome" />
    <div class="actions editor-toolbar">
        <button class="btn" @onclick="() => Empty()">Start empty</button><button class="btn" disabled="@(Definition is null)" @onclick="() => LoadActive()">Load active definition</button>
        <span class="muted">@(_draft.Dirty ? "Unsaved draft" : "Draft matches loaded version")</span>
    </div>
    <div class="form-row">
        <label>Network name <input @bind="Name" @bind:after="ValidateAsync" /></label>
        <label>Frequency (Hz) <input type="number" @bind="Frequency" @bind:after="ValidateAsync" /></label>
        <label>Version comment <input @bind="_comment" maxlength="1000" /></label>
        <button class="btn" disabled="@(_errors.Count > 0 || string.IsNullOrWhiteSpace(_comment))" @onclick="() => Save()">Save new version</button>
    </div>
    <section class="panel validation" aria-live="polite"><h2>Validation</h2>
        @if (_errors.Count == 0) { <p>Network definition is valid.</p> }
        else { <ul>@foreach (var error in _errors) { <li>@error</li> }</ul> }
    </section>
    <div class="editor-layout">
        <aside class="panel palette"><h2>Equipment palette</h2><p class="muted">Click to add, or drag onto the canvas. Drag nodes to move; positions snap to the grid.</p>
            @foreach (var kind in Catalog.Palette)
            {
                <button class="btn" draggable="true" @ondragstart="() => BeginPalette(kind)" @onclick="() => Add(kind)">Add @kind</button>
            }
            <h2>Elements and terminals</h2>
            @foreach (var id in _draft.AllIds())
            {
                <button class="btn @(_draft.SelectedId == id ? "selected" : "")" @onclick="() => Terminal(id)">@id</button>
            }
        </aside>
        <div>
            <div class="actions diagram-tools">
                <button class="btn" disabled="@(_draft.SelectedId is null)" @onclick="() => Connect()">Connect selected</button>
                <button class="btn" @onclick="() => CancelConnect()">Cancel connection</button>
                <button class="btn" disabled="@(!_draft.Definition.Lines.Any(l => l.Id == _draft.SelectedId))" @onclick="() => Waypoint()">@(_waypoint ? "Stop waypoints" : "Add waypoints")</button>
                <button class="btn" disabled="@(_draft.SelectedId is null)" @onclick="() => Delete()">Delete selected</button>
            </div>
            <p role="status">@_draft.Message @(_waypoint ? "Click canvas to add a waypoint." : "")</p>
            <svg @ref="_canvas" class="grid-diagram editor-canvas" viewBox="@ViewBox" role="img" aria-label="Network editor canvas"
                 @onpointerdown="CanvasDown" @onpointermove="Move" @onpointerup="StopMove" @onpointercancel="StopMove"
                 @ondragover:preventDefault @ondrop="Drop">
                <defs><pattern id="editor-grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40,0 L0,0 L0,40" class="snap-grid" /></pattern></defs>
                <rect x="-2000" y="-2000" width="12000" height="12000" fill="url(#editor-grid)" />
                @foreach (var line in _draft.Definition.Lines)
                {
                    <polyline points="@GridDiagramGeometry.LinePath(_draft.Definition, line)" class="grid-wire @(_draft.SelectedId == line.Id ? "selected-wire" : "")" role="button" tabindex="0" aria-label="@line.Id"
                        @onpointerdown:stopPropagation @onclick="() => Terminal(line.Id)" @onkeydown="e => Key(e, line.Id)" />
                    @foreach (var waypoint in line.Waypoints) { <circle cx="@(waypoint.X * 40)" cy="@(waypoint.Y * 40)" r="4" class="waypoint" /> }
                }
                @foreach (var node in _draft.Nodes)
                {
                    @foreach (var busId in GridDiagramGeometry.ConnectedBuses(_draft.Definition, node))
                    {
                        <polyline points="@GridDiagramGeometry.ConnectionPath(_draft.Definition, busId, node)" class="grid-wire voltage-mv" />
                    }
                    <g transform="@GridDiagramGeometry.Transform(node.Position)" class="grid-node @(_draft.SelectedId == node.Id ? "selected" : "")" role="button" tabindex="0" aria-label="@node.Id"
                       @onpointerdown="e => StartMove(node.Id, e)" @onpointerdown:stopPropagation @onclick="() => Terminal(node.Id)" @onkeydown="e => Key(e, node.Id)">
                        <GridSymbol Kind="@node.Kind" Closed="@(_draft.Definition.Switches.FirstOrDefault(s => s.Id == node.Id)?.NormallyClosed ?? false)" />
                        <text x="24" y="-8">@node.Id</text><circle cx="0" cy="0" r="5" class="terminal" />
                    </g>
                }
            </svg>
            <div class="actions diagram-tools">
                <button class="btn" @onclick="() => Zoom(.8)">Zoom in</button><button class="btn" @onclick="() => Zoom(1.25)">Zoom out</button>
                <button class="btn" @onclick="() => Pan(-200, 0)">Left</button><button class="btn" @onclick="() => Pan(200, 0)">Right</button>
                <button class="btn" @onclick="() => Pan(0, -200)">Up</button><button class="btn" @onclick="() => Pan(0, 200)">Down</button>
            </div>
        </div>
        <GridEditorProperties Draft="_draft" Changed="ValidateAsync" />
    </div>
    <section class="panel"><h2>Saved versions</h2>
        <table class="grid"><thead><tr><th>Version</th><th>Network</th><th>Created</th><th>Author</th><th>Comment</th><th>State</th><th></th></tr></thead><tbody>
            @foreach (var version in _versions.OrderByDescending(v => v.Version))
            {
                <tr><td>@version.Version</td><td>@version.Definition.Name</td><td>@version.CreatedAt.ToString("u", CultureInfo.InvariantCulture)</td>
                    <td>@version.CreatedBy</td><td>@version.Comment</td><td>@(version.Active ? "Active" : "Saved")</td><td class="actions">
                        <button class="btn" @onclick="() => LoadVersion(version)">Load draft</button>
                        <button class="btn" disabled="@version.Active" @onclick="() => Activate(version.Version)">Activate version @version.Version</button></td></tr>
            }
        </tbody></table>
    </section>
    <ConfirmDialog Pending="Pending" Completed="CompleteAsync" />
}

@code {
    private readonly GridEditorDocument _draft = new();
    private IReadOnlyList<string> _errors = [];
    private IReadOnlyList<GridDefinitionVersion> _versions = [];
    private string _comment = "", _paletteKind = "";
    private bool _loaded, _reloadVersions = true, _waypoint, _moved;
    private string? _moving;
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private double _x = -80, _y = -80, _width = 1400, _height = 900;
    private string ViewBox => $"{GridDiagramGeometry.N(_x)} {GridDiagramGeometry.N(_y)} {GridDiagramGeometry.N(_width)} {GridDiagramGeometry.N(_height)}";
    private string Name { get => _draft.Definition.Name; set => _draft.Replace(_draft.Definition with { Name = value }); }
    private double Frequency { get => _draft.Definition.NominalFrequencyHz; set => _draft.Replace(_draft.Definition with { NominalFrequencyHz = value }); }
    protected override bool Refresh()
    {
        base.Refresh();
        if (Session.IsInstructor && !_loaded)
        {
            _draft.Load(Definition ?? GridEditorDocument.Empty()); _loaded = true; Validate();
        }
        return true;
    }
    protected override async Task RefreshAsync(CancellationToken cancellationToken)
    {
        if (!Session.IsInstructor || !_reloadVersions) return;
        if (Services.GetService<IGridDefinitionStore>() is { } store)
            _versions = await store.ListAsync(cancellationToken);
        _reloadVersions = false;
    }
    private Task ValidateAsync() { Validate(); return Task.CompletedTask; }
    private bool Validate()
    {
        _errors = Services.GetService<IGridDefinitionAdministration>()?.Validate(_draft.Definition) ?? ["Grid definition services are not available."];
        return true;
    }
    private bool Add(string kind) { _draft.Add(kind); _waypoint = false; return Validate(); }
    private bool Terminal(string id)
    {
        if (_moved) { _moved = false; return true; }
        _draft.Terminal(id); return Validate();
    }
    private bool Key(KeyboardEventArgs e, string id) => e.Key is "Enter" or " " && Terminal(id);
    private bool Connect() { _waypoint = false; return _draft.BeginConnection(); }
    private bool CancelConnect() => _draft.CancelConnection();
    private bool Waypoint() { _draft.CancelConnection(); _waypoint = !_waypoint; return true; }
    private bool BeginPalette(string kind) { _paletteKind = kind; return true; }
    private async Task<IJSObjectReference> ModuleAsync() => _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Hmi/grid-pointer.js");
    private async Task Drop(DragEventArgs e)
    {
        if (string.IsNullOrEmpty(_paletteKind)) return;
        var point = await (await ModuleAsync()).InvokeAsync<DiagramPosition>("point", _canvas, e.ClientX, e.ClientY);
        _draft.Add(_paletteKind, new DiagramPosition(point.X / 40, point.Y / 40)); _paletteKind = ""; Validate();
    }
    private async Task StartMove(string id, PointerEventArgs e)
    {
        if (_draft.ConnectingElement is not null || _waypoint) return;
        _moving = id; _moved = false; _draft.Select(id);
        await (await ModuleAsync()).InvokeAsync<DiagramPosition>("capture", _canvas, e.PointerId, e.ClientX, e.ClientY);
    }
    private async Task Move(PointerEventArgs e)
    {
        if (_moving is null) return;
        var point = await (await ModuleAsync()).InvokeAsync<DiagramPosition>("point", _canvas, e.ClientX, e.ClientY);
        _draft.Move(_moving, new DiagramPosition(point.X / 40, point.Y / 40)); _moved = true; Validate();
    }
    private async Task StopMove(PointerEventArgs e)
    {
        _moving = null;
        if (_module is not null) await _module.InvokeAsync<bool>("release", _canvas, e.PointerId);
    }
    private async Task CanvasDown(PointerEventArgs e)
    {
        if (!_waypoint) return;
        var point = await (await ModuleAsync()).InvokeAsync<DiagramPosition>("point", _canvas, e.ClientX, e.ClientY);
        _draft.AddWaypoint(new DiagramPosition(point.X / 40, point.Y / 40)); Validate();
    }
    private bool Zoom(double factor) { _width = Math.Clamp(_width * factor, 100, 10000); _height = Math.Clamp(_height * factor, 75, 7500); return true; }
    private bool Pan(double x, double y) { _x += x; _y += y; return true; }
    private bool Delete() => Ask($"Delete {_draft.SelectedId}?", "Remove the selected equipment from this draft. Validation will identify references that need repair.", () => { _draft.DeleteSelected(); Validate(); return ActionOutcome.Done("Equipment removed from draft."); });
    private bool Empty() => Ask("Start an empty network?", "Replace the current draft. Unsaved changes will be lost.", () => { _draft.Load(GridEditorDocument.Empty()); Validate(); return ActionOutcome.Done("Empty draft created."); });
    private bool LoadActive() => LoadDraft(Definition!);
    private bool LoadVersion(GridDefinitionVersion version) => LoadDraft(version.Definition);
    private bool LoadDraft(GridDefinition definition) => Ask("Replace editor draft?", "Load this definition into the editor. Unsaved changes will be lost.", () => { _draft.Load(definition); Validate(); return ActionOutcome.Done("Definition loaded into draft."); });
    private bool Save()
    {
        var definition = _draft.Definition; var comment = _comment;
        return Ask("Save a new network version?", $"Save '{definition.Name}' with comment: {comment}. The running simulation is changed only when you activate a version.", async () =>
        {
            var result = await Services.GetRequiredService<IGridDefinitionAdministration>().SaveAsync(definition, comment, Session.Actor, StoppingToken);
            _errors = result.Errors;
            if (result.Saved) { _draft.MarkSaved(); _reloadVersions = true; }
            return result.Saved ? ActionOutcome.Done($"Saved version {result.Version}.") : ActionOutcome.Failed(string.Join(" ", result.Errors));
        }, dangerous: false);
    }
    private bool Activate(int version) => Ask($"Activate version {version}?", "This restarts the grid simulation for every grid operator and replaces its current state.", async () =>
    {
        var result = await Services.GetRequiredService<IGridRuntime>().ActivateVersionAsync(version, Session.Actor, StoppingToken);
        _reloadVersions = true;
        return ActionOutcome.From(result);
    });
    public override async ValueTask DisposeAsync()
    {
        await base.DisposeAsync();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }

}
