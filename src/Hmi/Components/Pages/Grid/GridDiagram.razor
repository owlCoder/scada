@page "/grid/diagram"
@inherits GridPageBase
@inject IJSRuntime JS

<PageTitle>Single-line diagram · SCADA</PageTitle>
<h1>Single-line diagram</h1>
<GridPageStatus Error="@RefreshError" Available="@(Snapshot is not null)" />
<div class="actions diagram-tools">
    <button class="btn" @onclick="() => Zoom(0.8)">Zoom in</button><button class="btn" @onclick="() => Zoom(1.25)">Zoom out</button>
    <button class="btn" @onclick="() => Pan(-100, 0)">Pan left</button><button class="btn" @onclick="() => Pan(100, 0)">Pan right</button>
    <button class="btn" @onclick="() => Pan(0, -100)">Pan up</button><button class="btn" @onclick="() => Pan(0, 100)">Pan down</button>
    <button class="btn" @onclick="() => Fit()">Fit network</button>
</div>
@if (Snapshot is { } grid && Definition is { } definition)
{
    <div class="diagram-layout">
        <svg @ref="_canvas" class="grid-diagram" viewBox="@ViewBox" role="img" aria-label="Electrical single-line diagram" @onpointerdown="StartPan" @onpointermove="MovePan" @onpointerup="EndPan" @onwheel="e => Wheel(e)" @onwheel:preventDefault>
            @foreach (var line in definition.Lines)
            {
                var branch = grid.Branch(line.Id);
                <g role="button" tabindex="0" aria-label="@line.Name" @onclick="() => Select(line.Id)" @onkeydown="e => SelectKey(e, line.Id)">
                    <polyline points="@GridDiagramGeometry.LinePath(definition, line)" class="@LineClass(definition, line, branch)" />
                    @if (definition.Buses.FirstOrDefault(b => b.Id == line.FromBusId) is { } origin)
                    {
                        <g transform="@GridDiagramGeometry.Transform(origin.Position)"><text x="15" y="-25">@line.Id · @Number(branch?.CurrentA ?? 0) A · @Number(branch?.LoadingPercent ?? 0) %</text></g>
                    }
                </g>
            }
            @foreach (var node in GridDiagramGeometry.Nodes(definition))
            {
                @foreach (var busId in GridDiagramGeometry.ConnectedBuses(definition, node))
                {
                    var bus = definition.Buses.FirstOrDefault(b => b.Id == busId);
                    @if (bus is not null)
                    {
                        <polyline points="@GridDiagramGeometry.ConnectionPath(definition, busId, node)" class="grid-wire @GridDiagramGeometry.VoltageClass(bus.NominalVoltageKv) @(Energized(node.Id) ? "" : "deenergized")" />
                    }
                }
                <g transform="@GridDiagramGeometry.Transform(node.Position)" class="grid-node @(Energized(node.Id) ? "" : "deenergized") @(_selected == node.Id ? "selected" : "")"
                   role="button" tabindex="0" aria-label="@node.Name" @onclick="() => Select(node.Id)" @onpointerdown:stopPropagation @onkeydown="e => SelectKey(e, node.Id)">
                    <title>@node.Name</title>
                    <GridSymbol Kind="@node.Kind" Closed="@(grid.Switch(node.Id)?.Closed ?? false)" Tap="@(grid.Branch(node.Id)?.TapPosition)" />
                    <text x="28" y="-4">@node.Id</text><text x="28" y="13" class="grid-value">@Value(node.Id)</text>
                    @if (grid.Branch(node.Id) is { } branch)
                    {
                        <g transform="translate(28 20) scale(.7)"><GridLoadingBar Percent="branch.LoadingPercent" /></g>
                    }
                </g>
            }
        </svg>
        @if (_selected is not null) { <GridFaceplate @key="_selected" ElementId="@_selected" /> }
        else { <aside class="panel detail"><h2>Faceplate</h2><p>Select an element to inspect measurements and controls.</p>
            <p class="muted">Heavy / medium / fine lines: HV / MV / LV. Dashed: de-energized. Filled square: closed breaker; hollow: open.</p></aside> }
    </div>
}

@code {
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private string? _selected;
    private double _x = -80, _y = -80, _width = 1000, _height = 700;
    private bool _fit;
    private DiagramPosition? _pan;
    private string ViewBox => $"{GridDiagramGeometry.N(_x)} {GridDiagramGeometry.N(_y)} {GridDiagramGeometry.N(_width)} {GridDiagramGeometry.N(_height)}";
    protected override bool Refresh()
    {
        base.Refresh();
        if (!_fit && Definition is not null) { Fit(); _fit = true; }
        return true;
    }
    private bool Fit()
    {
        var nodes = Definition is null ? [] : GridDiagramGeometry.Nodes(Definition);
        _x = nodes.Count == 0 ? -80 : nodes.Min(n => n.Position.X) * 40 - 80;
        _y = nodes.Count == 0 ? -80 : nodes.Min(n => n.Position.Y) * 40 - 80;
        _width = nodes.Count == 0 ? 1000 : Math.Max(400, nodes.Max(n => n.Position.X) * 40 - _x + 220);
        _height = nodes.Count == 0 ? 700 : Math.Max(300, nodes.Max(n => n.Position.Y) * 40 - _y + 100);
        return true;
    }
    private bool Select(string id) { _selected = id; return true; }
    private bool SelectKey(KeyboardEventArgs e, string id) => e.Key is "Enter" or " " && Select(id);
    private bool Zoom(double factor) { _width = Math.Clamp(_width * factor, 100, 10000); _height = Math.Clamp(_height * factor, 75, 7500); return true; }
    private bool Pan(double x, double y) { _x += x; _y += y; return true; }
    private bool Wheel(WheelEventArgs e) => Zoom(e.DeltaY < 0 ? .9 : 1.1);
    private async Task StartPan(PointerEventArgs e)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Hmi/grid-pointer.js");
        _pan = await _module.InvokeAsync<DiagramPosition>("capture", _canvas, e.PointerId, e.ClientX, e.ClientY);
    }
    private async Task MovePan(PointerEventArgs e)
    {
        if (_pan is null || _module is null) return;
        var point = await _module.InvokeAsync<DiagramPosition>("point", _canvas, e.ClientX, e.ClientY);
        _x -= point.X - _pan.X; _y -= point.Y - _pan.Y;
    }
    private async Task EndPan(PointerEventArgs e)
    {
        _pan = null;
        if (_module is not null) await _module.InvokeAsync<bool>("release", _canvas, e.PointerId);
    }
    private bool Energized(string id) => Snapshot?.Bus(id)?.Energized ?? Snapshot?.Branch(id)?.Energized ?? Snapshot?.Load(id)?.Energized
        ?? (Definition?.Switches.FirstOrDefault(s => s.Id == id) is { } sw ? Snapshot?.Bus(sw.BusId)?.Energized == true && Snapshot.Switch(id)?.Closed == true : true);
    private string Value(string id)
    {
        if (Snapshot?.Bus(id) is { } bus) return $"{Number(bus.VoltageKv)} kV";
        if (Snapshot?.Branch(id) is { } branch) return $"{Number(branch.CurrentA)} A · {Number(branch.LoadingPercent)} % · tap {branch.TapPosition}";
        if (Snapshot?.Load(id) is { } load) return $"{Number(load.ActivePowerMw)} MW";
        return Snapshot?.Switch(id) is { } sw ? sw.Closed ? "Closed" : "Open" : "";
    }
    private static string LineClass(GridDefinition definition, GridLineDefinition line, BranchSnapshot? branch) =>
        $"grid-wire {GridDiagramGeometry.VoltageClass(definition.Buses.FirstOrDefault(b => b.Id == line.FromBusId)?.NominalVoltageKv ?? 20)} {(branch?.Energized == true ? "" : "deenergized")}";

    public override async ValueTask DisposeAsync()
    {
        await base.DisposeAsync();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }

}
