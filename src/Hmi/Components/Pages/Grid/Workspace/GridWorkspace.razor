@page "/grid/diagram"
@inherits GridPageBase
@inject IJSRuntime JS
@inject Hmi.Services.Shell.ShellState Shell
@inject Hmi.Services.Shell.ShellAlarmMonitor ShellAlarms

@* Grid dispatcher workspace: full-viewport single-line diagram canvas hosted as-is (GridSld), a right dock with the
   control window for the selected element, and a resizable bottom dock with alarm/event/command/trend/tag tabs.
   Dock layout and sizes are remembered per user in localStorage through the workspace JS module; all state stays in C#. *@
<PageTitle>Grid dispatcher workspace · SCADA</PageTitle>
<h1 class="visually-hidden">Single-line diagram</h1>
<div class="grid-workspace">
    <div class="workspace-canvas">
        <GridPageStatus Error="@RefreshError" Available="@(Snapshot is not null)" />
        @if (Snapshot is { } grid && Definition is { } definition)
        {
            <GridSld Snapshot="grid" Definition="definition" Tags="@TagList" SelectedId="@SelectedId"
                     SelectedIdChanged="@(id => Select(id))" OnAction="@(action => HandleAction(action))" CanOperate="@Session.CanOperate" />
        }
    </div>
    <aside class="dock dock-right @(_layout.RightCollapsed ? "collapsed" : "")" aria-label="Control window dock">
        <div class="dock-head">
            <h2>Control window</h2>
            <button type="button" class="btn dock-toggle" aria-expanded="@(!_layout.RightCollapsed)"
                    aria-label="@(_layout.RightCollapsed ? "Open control window" : "Collapse control window")"
                    title="@(_layout.RightCollapsed ? "Open control window" : "Collapse control window")"
                    @onclick="() => ToggleRight()">@(_layout.RightCollapsed ? "◂" : "▸")</button>
        </div>
        @if (!_layout.RightCollapsed)
        {
            <div class="dock-body dock-right-body">
                @if (SelectedId is { } selected)
                {
                    <GridControlWindow @key="selected" @ref="_controlWindow" ElementId="@selected" Tags="@TagList" Tagging="@Tagging" History="@History" />
                }
                else
                {
                    <EmptyState Message="Select an element on the diagram (click, Enter on it, or an alarm row) to open its control window." />
                }
            </div>
        }
    </aside>
    <section class="dock dock-bottom @(_layout.BottomCollapsed ? "collapsed" : "")" @ref="_bottomDock" aria-label="Workspace bottom dock">
        <div class="dock-resize" @ref="_bottomHandle" role="separator" aria-orientation="horizontal" aria-label="Resize bottom dock" title="Drag to resize"></div>
        <div class="dock-head">
            <h2>@TabName(_layout.Tab) dock</h2>
            @if (_layout.BottomCollapsed && _unackCount > 0)
            {
                <span class="dock-badge @_unackTopClass blink-unack" role="status"
                      title="@_unackCount unacknowledged alarm(s) — expand the dock to review them">@_unackCount</span>
            }
            <button type="button" class="btn dock-toggle" aria-expanded="@(!_layout.BottomCollapsed)"
                    aria-label="@(_layout.BottomCollapsed ? "Open bottom dock" : "Collapse bottom dock")"
                    title="@(_layout.BottomCollapsed ? "Open bottom dock" : "Collapse bottom dock")"
                    @onclick="() => ToggleBottom()">@(_layout.BottomCollapsed ? "▴" : "▾")</button>
        </div>
        @if (!_layout.BottomCollapsed)
        {
            <div class="dock-body dock-bottom-body">
                <GridBottomDock Tags="@TagList" Tagging="@Tagging" History="@History" Tab="@_layout.Tab"
                                TabChanged="@(tab => ChangeTab(tab))" FocusElementId="@_trendElement" SelectElement="@(id => Select(id))" />
            </div>
        }
    </section>
</div>

@code {
    private GridControlWindow? _controlWindow;
    private ElementReference _bottomDock;
    private ElementReference _bottomHandle;
    private IJSObjectReference? _module;
    private DotNetObjectReference<GridWorkspace>? _self;
    private GridWorkspaceLayout _layout = GridWorkspaceLayout.Default;
    private string? _trendElement;
    private GridSldAction? _pendingRequest;
    private int _unackCount;
    private string? _unackTopClass;

    protected string? SelectedId { get; private set; }
    private IGridTagging? Tagging => Services.GetService<IGridTagging>();
    private IGridHistory? History => Services.GetService<IGridHistory>();
    private IReadOnlyList<GridTag> TagList => Tagging?.Tags ?? [];

    protected override IReadOnlyCollection<string> Topics => [.. base.Topics, RealtimeTopics.GridTags];

    protected override bool Refresh()
    {
        var changed = base.Refresh();
        // Unacknowledged alarm count for the collapsed-dock badge (highest priority first).
        var counts = ShellAlarms.UnacknowledgedCounts();
        _unackCount = counts.Sum(c => c.Count);
        _unackTopClass = counts.Where(c => c.Count > 0)
            .Select(c => c.Severity switch
            {
                Domain.Process.Alarms.AlarmSeverity.Critical => "p1",
                Domain.Process.Alarms.AlarmSeverity.High => "p2",
                Domain.Process.Alarms.AlarmSeverity.Medium => "p3",
                _ => "p4"
            })
            .FirstOrDefault();
        return changed;
    }

    private bool Select(string? id)
    {
        SelectedId = id;
        _pendingRequest = null;
        // Publish the selection to the shell so the status bar shows what the workspace has selected.
        Shell.Selected = id is null ? null : $"{id} · {GridWorkspaceElements.Resolve(Snapshot, Definition, id)?.Name ?? id}";
        return true;
    }

    /// <summary>Handles a canvas action request (context menu / double-click / keyboard on the diagram).</summary>
    public bool HandleAction(GridSldAction action)
    {
        Select(action.ElementId);
        switch (action.Kind)
        {
            case GridSldActionKind.OpenControl:
                _layout = _layout with { RightCollapsed = false };
                break;
            case GridSldActionKind.SelectOpen:
            case GridSldActionKind.SelectClose:
            case GridSldActionKind.PlaceTag:
            case GridSldActionKind.ShowDetails:
                _layout = _layout with { RightCollapsed = false };
                _pendingRequest = action;
                break;
            case GridSldActionKind.ShowTrend:
                _layout = _layout with { BottomCollapsed = false, Tab = GridWorkspaceTab.Trend };
                _trendElement = action.ElementId;
                break;
        }
        _ = SaveLayoutAsync();
        _ = InvokeAsync(StateHasChanged);
        return true;
    }

    [JSInvokable]
    public bool OnWorkspaceKey(string key)
    {
        switch (key)
        {
            case "Escape":
                Select(null);
                break;
            case "Enter":
                if (SelectedId is not null)
                    _layout = _layout with { RightCollapsed = false };
                break;
            case "Delete":
                if (_controlWindow is not null)
                    _ = _controlWindow.RequestCancelSelectionAsync();
                break;
        }
        _ = SaveLayoutAsync();
        _ = InvokeAsync(StateHasChanged);
        return true;
    }

    [JSInvokable]
    public bool OnBottomResize(double heightPx)
    {
        _layout = _layout with { BottomHeightPx = heightPx };
        _ = SaveLayoutAsync();
        _ = InvokeAsync(StateHasChanged);
        return true;
    }

    private bool ToggleRight()
    {
        _layout = _layout with { RightCollapsed = !_layout.RightCollapsed };
        _ = SaveLayoutAsync();
        return true;
    }

    private bool ToggleBottom()
    {
        _layout = _layout with { BottomCollapsed = !_layout.BottomCollapsed };
        _ = SaveLayoutAsync();
        return true;
    }

    private bool ChangeTab(GridWorkspaceTab tab)
    {
        _layout = _layout with { Tab = tab };
        _ = SaveLayoutAsync();
        return true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Hmi/js/workspace-dock.js");
                if (_module is not null)
                {
                    _self = DotNetObjectReference.Create(this);
                    var key = GridWorkspaceLayout.StorageKey(Session.Actor.Name);
                    var stored = await _module.InvokeAsync<GridWorkspaceLayout?>("load", key);
                    if (stored is not null)
                    {
                        _layout = stored;
                        // Re-render once so the remembered collapsed state / height / tab apply on first paint.
                        await InvokeAsync(StateHasChanged);
                    }
                    await _module.InvokeVoidAsync("attachKeys", _self);
                    await _module.InvokeVoidAsync("startBottomDrag", _bottomHandle, _bottomDock, _self);
                    if (_layout.BottomHeightPx is { } height)
                        await _module.InvokeVoidAsync("applyBottomHeight", _bottomDock, height);
                }
            }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
        }
        if (_pendingRequest is { } request && _controlWindow is not null)
        {
            _pendingRequest = null;
            switch (request.Kind)
            {
                case GridSldActionKind.SelectOpen:
                    await _controlWindow.BeginSelectAsync(GridCommandType.SelectOpen);
                    break;
                case GridSldActionKind.SelectClose:
                    await _controlWindow.BeginSelectAsync(GridCommandType.SelectClose);
                    break;
                case GridSldActionKind.PlaceTag:
                    await _controlWindow.BeginPlaceTagAsync();
                    break;
                case GridSldActionKind.ShowDetails:
                    await _controlWindow.BeginShowDetailsAsync();
                    break;
            }
        }
    }

    private async Task SaveLayoutAsync()
    {
        if (_module is null || _self is null)
            return;
        try
        {
            await _module.InvokeVoidAsync("save", GridWorkspaceLayout.StorageKey(Session.Actor.Name), _layout);
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    private static string TabName(GridWorkspaceTab tab) => tab switch
    {
        GridWorkspaceTab.Alarms => "Alarms",
        GridWorkspaceTab.Events => "Events",
        GridWorkspaceTab.Commands => "Commands",
        GridWorkspaceTab.Trend => "Trend",
        GridWorkspaceTab.Tags => "Tags",
        _ => tab.ToString()
    };

    public override async ValueTask DisposeAsync()
    {
        Shell.Selected = null;
        await base.DisposeAsync();
        _self?.Dispose();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
