@page "/alarms"
@inherits RealtimeComponentBase
@inject Application.Alarms.AlarmService AlarmService
@inject TimeProvider Clock

<PageTitle>Alarms · SCADA</PageTitle>
<RefreshErrorBanner Error="@RefreshError" />
<header class="page-head">
    <h1>Alarms</h1>
    <p class="page-sub muted">ISA-18.2 presentation: priority, state (active/cleared), acknowledgement, time and duration.
        Unacknowledged active alarms stay highlighted and remain listed after they clear.</p>
</header>
<OutcomeBanner Outcome="_outcome" />

<section class="panel">
    <h2>Current</h2>
    @if (_current.Count == 0)
    {
        <EmptyState Message="No alarms." />
    }
    else
    {
        <div class="table-scroll">
            <table class="grid alarm-table">
                <thead><tr><th>Priority</th><th>Raised</th><th>Duration</th><th>Source</th><th>Alarm</th><th>State</th><th>Acknowledgement</th><th></th></tr></thead>
                <tbody>
                    @foreach (var alarm in _current)
                    {
                        <tr class="@(alarm.IsActive && !alarm.IsAcknowledged ? "row-alarm" : "")">
                            <td><StatusPill Text="@alarm.Severity.ToString()" Kind="@(alarm.Severity >= AlarmSeverity.High ? "alarm" : "warn")" /></td>
                            <td class="nowrap">@alarm.RaisedAt.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture)</td>
                            <td class="nowrap">@Duration(alarm)</td>
                            <td>@alarm.SourceId</td>
                            <td>@alarm.Message</td>
                            <td><StatusPill Text="@(alarm.IsActive ? "Active" : "Cleared")" Kind="@(alarm.IsActive ? "alarm" : "ok")" /></td>
                            <td>@(alarm.IsAcknowledged ? $"Acknowledged by {alarm.AcknowledgedBy}" : "Unacknowledged")</td>
                            <td>
                                @if (Session.CanOperate && !alarm.IsAcknowledged)
                                {
                                    <button class="btn" @onclick="() => AskAcknowledge(alarm.Key)">Acknowledge</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel">
    <h2>History</h2>
    @if (_history.Count == 0)
    {
        <EmptyState Message="No alarm history yet." />
    }
    else
    {
        <div class="table-scroll">
            <table class="grid">
                <thead><tr><th>Time</th><th>Alarm</th><th>Transition</th><th>By</th></tr></thead>
                <tbody>
                    @foreach (var record in _history)
                    {
                        <tr>
                            <td class="nowrap">@record.Timestamp.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture)</td>
                            <td>@record.Message</td>
                            <td>@record.Transition</td>
                            <td>@(record.Actor ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<ConfirmDialog Pending="_pending" Completed="OnCompletedAsync" />

@code {
    private IReadOnlyList<ProcessAlarm> _current = [];
    private IReadOnlyList<Application.Alarms.AlarmHistoryRecord> _history = [];
    private ActionOutcome? _outcome;
    private PendingAction? _pending;
    private long _loadId;

    protected override IReadOnlyCollection<string> Topics => [RealtimeTopics.Alarms];
    protected override TimeSpan MinimumRefreshInterval => TimeSpan.FromSeconds(1);

    protected override bool Refresh()
    {
        _current = AlarmService.GetCurrent().OrderByDescending(a => a.IsActive).ThenByDescending(a => a.Severity).ThenByDescending(a => a.RaisedAt).ToArray();
        return true;
    }

    protected override async Task RefreshAsync(CancellationToken cancellationToken)
    {
        var loadId = ++_loadId;
        var history = await AlarmService.GetHistoryAsync(50, cancellationToken);
        if (loadId == _loadId && !cancellationToken.IsCancellationRequested)
            _history = history;
    }

    private string Duration(ProcessAlarm alarm)
    {
        var duration = (alarm.ClearedAt ?? Clock.GetUtcNow()) - alarm.RaisedAt;
        return duration < TimeSpan.FromDays(1)
            ? duration.ToString(@"hh\:mm\:ss", CultureInfo.InvariantCulture)
            : duration.ToString(@"d\.hh\:mm\:ss", CultureInfo.InvariantCulture);
    }

    private bool AskAcknowledge(string key)
    {
        _pending = new PendingAction("Acknowledge alarm?", "Record your acknowledgement of this alarm.", () =>
            Task.FromResult(AlarmService.Acknowledge(key, Session.Actor)
                ? ActionOutcome.Done("Alarm acknowledged.") : ActionOutcome.Failed("Alarm acknowledgement failed.")));
        return true;
    }

    private async Task OnCompletedAsync(ActionOutcome? outcome)
    {
        _pending = null;
        _outcome = outcome ?? _outcome;
        await RefreshNowAsync();
    }
}
