@page "/diagram"
@inherits RealtimeComponentBase

<PageTitle>Plant diagram · SCADA</PageTitle>
<RefreshErrorBanner Error="@RefreshError" />
<header class="page-head">
    <h1>Plant diagram</h1>
    <p class="page-sub muted">@(Session.IsInstructor ? "Instructor view: true process values." : "Values as reported by the field instruments.")
        Select a device for its faceplate. Grey lines are process piping; red marks abnormal states only.</p>
</header>

<div class="diagram-layout">
    <svg class="diagram" viewBox="0 0 @N(_layout.Width) @N(_layout.Height)" role="img" aria-label="Live plant diagram (P&ID)">
        @foreach (var pump in _plant.Pumps)
        {
            var (px, py) = _layout.Position(pump.Id);
            var from = _layout.TankCenter(pump.SourceTankId);
            var to = _layout.TankCenter(pump.TargetTankId);
            var bottom = PlantLayout.TankTop + PlantLayout.TankHeight;
            <polyline class="pipe @(pump.FlowRate > 0.001 ? "pipe-flow" : "")"
                      points="@N(from),@N(bottom) @N(from),@N(py) @N(px),@N(py) @N(to),@N(py) @N(to),@N(bottom)" />
        }
        @foreach (var valve in _plant.Valves.Where(v => v.Role != ValveRole.Discharge))
        {
            var (vx, vy) = _layout.Position(valve.Id);
            var tankEdge = valve.Role == ValveRole.Inlet ? PlantLayout.TankTop : PlantLayout.TankTop + PlantLayout.TankHeight;
            <line class="pipe @(valve.FlowRate > 0.001 ? "pipe-flow" : "")" x1="@N(vx)" y1="@N(vy)" x2="@N(vx)" y2="@N(tankEdge)" />
        }

        @foreach (var tank in _plant.Tanks)
        {
            var (tx, ty) = _layout.Position(tank.Id);
            var fill = PlantLayout.TankHeight * Math.Clamp(tank.LevelPercent, 0, 100) / 100;
            <g class="device @(Selected(tank.Id))" @onclick="() => Select(tank.Id)" @onkeydown="e => SelectKey(e, tank.Id)"
               tabindex="0" role="button" aria-label="@tank.Name">
                <title>@tank.Name</title>
                <rect class="tank" x="@N(tx)" y="@N(ty)" width="@N(PlantLayout.TankWidth)" height="@N(PlantLayout.TankHeight)" rx="6" />
                <rect class="@(tank.LevelPercent >= tank.Thresholds.High || tank.LevelPercent <= tank.Thresholds.Low ? "liquid liquid-alarm" : "liquid")"
                      x="@N(tx + 3)" y="@N(ty + PlantLayout.TankHeight - fill)" width="@N(PlantLayout.TankWidth - 6)" height="@N(Math.Max(0, fill - 3))" rx="4" />
                <line class="tank-limit tank-limit-critical" x1="@N(tx + PlantLayout.TankWidth - 12)" y1="@N(LimitY(ty, tank.Thresholds.LowLow))" x2="@N(tx + PlantLayout.TankWidth - 2)" y2="@N(LimitY(ty, tank.Thresholds.LowLow))" />
                <line class="tank-limit" x1="@N(tx + PlantLayout.TankWidth - 12)" y1="@N(LimitY(ty, tank.Thresholds.Low))" x2="@N(tx + PlantLayout.TankWidth - 2)" y2="@N(LimitY(ty, tank.Thresholds.Low))" />
                <line class="tank-limit" x1="@N(tx + PlantLayout.TankWidth - 12)" y1="@N(LimitY(ty, tank.Thresholds.High))" x2="@N(tx + PlantLayout.TankWidth - 2)" y2="@N(LimitY(ty, tank.Thresholds.High))" />
                <line class="tank-limit tank-limit-critical" x1="@N(tx + PlantLayout.TankWidth - 12)" y1="@N(LimitY(ty, tank.Thresholds.HighHigh))" x2="@N(tx + PlantLayout.TankWidth - 2)" y2="@N(LimitY(ty, tank.Thresholds.HighHigh))" />
                <text class="label" x="@N(tx + PlantLayout.TankWidth / 2)" y="@N(ty - 10)">@tank.Id</text>
                <text class="value" x="@N(tx + PlantLayout.TankWidth / 2)" y="@N(ty + PlantLayout.TankHeight / 2)">@tank.LevelPercent.ToString("0.0", CultureInfo.InvariantCulture) %</text>
                @if (Quality(tank.Id, SensorKind.Level) is { } levelQuality && levelQuality != MeasurementQuality.Good)
                {
                    @:<text class="device-quality" x="@N(tx + PlantLayout.TankWidth / 2)" y="@N(ty + PlantLayout.TankHeight + 16)">quality: @levelQuality</text>
                }
            </g>
        }

        @foreach (var pump in _plant.Pumps)
        {
            var (px, py) = _layout.Position(pump.Id);
            <g class="device @(Selected(pump.Id))" @onclick="() => Select(pump.Id)" @onkeydown="e => SelectKey(e, pump.Id)"
               tabindex="0" role="button" aria-label="@pump.Name">
                <title>@pump.Name</title>
                <circle class="pump @PumpClass(pump)" cx="@N(px)" cy="@N(py)" r="20" />
                @if (pump.Health == DeviceHealth.Faulted)
                {
                    @:<text class="pump-fault-mark" x="@N(px)" y="@N(py + 8)">!</text>
                }
                else if (pump.State == PumpState.Running)
                {
                    <polygon class="pump-arrow" points="@N(px - 8),@N(py - 10) @N(px + 12),@N(py) @N(px - 8),@N(py + 10)" />
                }
                else
                {
                    <path class="pump-stop" d="M@N(px - 6),@N(py - 8) L@N(px - 6),@N(py + 8) M@N(px + 6),@N(py - 8) L@N(px + 6),@N(py + 8)" />
                }
                <text class="label" x="@N(px)" y="@N(py + 38)">@pump.Id</text>
                <text class="label small" x="@N(px)" y="@N(py + 52)">@pump.FlowRate.ToString("0.00", CultureInfo.InvariantCulture) m³/min</text>
                @if (Quality(pump.Id, SensorKind.Flow) is { } flowQuality && flowQuality != MeasurementQuality.Good)
                {
                    @:<text class="device-quality" x="@N(px)" y="@N(py + 66)">quality: @flowQuality</text>
                }
            </g>
        }

        @foreach (var valve in _plant.Valves)
        {
            var (vx, vy) = _layout.Position(valve.Id);
            <g class="device @(Selected(valve.Id))" @onclick="() => Select(valve.Id)" @onkeydown="e => SelectKey(e, valve.Id)"
               tabindex="0" role="button" aria-label="@valve.Name">
                <title>@valve.Name</title>
                <line class="valve-stem" x1="@N(vx)" y1="@N(vy - 10)" x2="@N(vx)" y2="@N(vy - 18)" />
                <polygon class="valve @(valve.Position > 0.5 ? "valve-open" : "valve-closed") @(valve.Health != DeviceHealth.Healthy ? "faulted" : "")"
                         points="@N(vx - 14),@N(vy - 10) @N(vx + 14),@N(vy + 10) @N(vx + 14),@N(vy - 10) @N(vx - 14),@N(vy + 10)" />
                <text class="label small" x="@N(vx)" y="@N(vy - 24)">@valve.Id @valve.Position.ToString("0", CultureInfo.InvariantCulture)%</text>
                @if (Quality(valve.Id, SensorKind.Flow) is { } valveQuality && valveQuality != MeasurementQuality.Good)
                {
                    @:<text class="device-quality" x="@N(vx)" y="@N(vy + 26)">quality: @valveQuality</text>
                }
            </g>
        }
    </svg>

    @if (_selected is null)
    {
        <aside class="panel detail">
            <h2>Faceplate</h2>
            <p>Select a tank, pump or valve to inspect and operate it.</p>
            <p class="muted">Filled pump circle with arrow: running. Stop bars: stopped. "!": faulted. Filled valve bowtie: open.</p>
        </aside>
    }
    else
    {
        <PlantFaceplate @key="_selected" DeviceId="@_selected" />
    }
</div>

@code {
    private PlantSnapshot _plant = default!;
    private PlantLayout _layout = default!;
    private string? _selected;

    protected override IReadOnlyCollection<string> Topics => [RealtimeTopics.Plant];

    protected override bool Refresh()
    {
        _plant = Session.Plant();
        _layout = new PlantLayout(_plant);
        return true;
    }

    private bool Select(string id)
    {
        _selected = id;
        return true;
    }

    private bool SelectKey(KeyboardEventArgs e, string id) => e.Key is "Enter" or " " && Select(id);

    private string Selected(string id) => id == _selected ? "selected" : "";

    private MeasurementQuality? Quality(string deviceId, SensorKind kind) =>
        _plant.Sensors.FirstOrDefault(s => s.DeviceId == deviceId && s.Kind == kind)?.Quality;

    private static double LimitY(double tankTop, double limit) =>
        tankTop + PlantLayout.TankHeight * (1 - Math.Clamp(limit, 0, 100) / 100);

    private static string PumpClass(PumpSnapshot pump) =>
        pump.Health == DeviceHealth.Faulted ? "faulted" : pump.State == PumpState.Running ? "running" : "stopped";

    private static string N(double value) => PlantLayout.Number(value);
}
