@page "/"
@inherits RealtimeComponentBase
@inject NavigationManager Navigation
@inject Application.Simulation.SimulationEngine Engine
@inject Application.Simulation.SimulationCoordinator Coordinator
@inject Security.Scenarios.ScenarioEngine Scenarios
@inject Application.Incidents.IncidentService Incidents

<PageTitle>Overview · SCADA</PageTitle>
<RefreshErrorBanner Error="@RefreshError" />
<h1>Overview</h1>

<section class="metrics">
    @foreach (var tank in _plant.Tanks)
    {
        <article class="panel metric">
            <h2>@tank.Name</h2>
            <strong>@tank.LevelPercent.ToString("0.0", CultureInfo.InvariantCulture) %</strong>
            <LevelBar Percent="tank.LevelPercent" Label="@tank.Name" High="tank.Thresholds.High" Low="tank.Thresholds.Low" />
        </article>
    }
    <article class="panel metric">
        <h2>Active alarms</h2>
        <strong>@_plant.Alarms.Count(a => a.IsActive)</strong>
        <a href="alarms">Open alarm list</a>
    </article>
    <article class="panel metric">
        <h2>Open incidents</h2>
        <strong>@_openIncidents</strong>
        <a href="incidents">Open incident list</a>
    </article>
</section>

<section class="columns">
    <article class="panel">
        <h2>Simulation</h2>
        <p>Step @_status?.StepCount · simulated @_status?.SimulationTime.ToString(@"hh\:mm\:ss", CultureInfo.InvariantCulture)
            · interlocks @(_plant.InterlocksBypassed ? "BYPASSED" : "active")</p>
        @if (Session.CanOperate)
        {
            <div class="actions">
                @if (_status?.IsPaused == true)
                {
                    <button class="btn btn-primary" @onclick="() => AskPause(false)">Resume</button>
                }
                else
                {
                    <button class="btn" @onclick="() => AskPause(true)">Pause</button>
                }
            </div>
        }
    </article>
    <article class="panel">
        <h2>Scenario</h2>
        @if (_scenario is { } run)
        {
            <p>@run.ScenarioName · @run.State · @run.ProgressPercent.ToString("0", CultureInfo.InvariantCulture) %</p>
        }
        else
        {
            <p class="muted">No scenario is running.</p>
        }
        <a href="scenarios">Scenarios and results</a>
    </article>
</section>
<OutcomeBanner Outcome="_outcome" />
<ConfirmDialog Pending="_pending" Completed="OnCompletedAsync" />

@code {
    private PlantSnapshot _plant = default!;
    private Application.Simulation.SimulationStatus? _status;
    private Application.Scenarios.ScenarioRunRecord? _scenario;
    private int _openIncidents;
    private ActionOutcome? _outcome;
    private PendingAction? _pending;
    private long _loadId;

    protected override IReadOnlyCollection<string> Topics =>
        [RealtimeTopics.Plant, RealtimeTopics.Simulation, RealtimeTopics.Scenarios, RealtimeTopics.Incidents];

    protected override bool Refresh()
    {
        if (Session.Mode == Application.Common.SimulationMode.Grid)
            Navigation.NavigateTo("/grid", replace: true);
        _plant = Session.Plant();
        _status = Engine.Status;
        _scenario = Scenarios.Current is { State: Application.Scenarios.ScenarioRunState.Running or Application.Scenarios.ScenarioRunState.Paused } current
            ? current : null;
        return true;
    }

    protected override async Task RefreshAsync(CancellationToken cancellationToken)
    {
        var loadId = ++_loadId;
        var page = await Incidents.QueryAsync(new Application.Incidents.IncidentQuery(ActiveOnly: true, PageSize: 1), cancellationToken);
        if (loadId == _loadId && !cancellationToken.IsCancellationRequested)
            _openIncidents = page.TotalCount;
    }

    private bool AskPause(bool paused)
    {
        _pending = new PendingAction(paused ? "Pause simulation?" : "Resume simulation?", "This changes the live simulation for all operators.", () =>
        {
            Coordinator.SetPaused(paused, Session.Actor);
            return Task.FromResult(Session.CanOperate
                ? ActionOutcome.Done(paused ? "Simulation paused." : "Simulation resumed.")
                : ActionOutcome.Failed("Operator role required."));
        });
        return true;
    }

    private async Task OnCompletedAsync(ActionOutcome? outcome)
    {
        _pending = null;
        _outcome = outcome ?? _outcome;
        await RefreshNowAsync();
    }
}
