@inherits RealtimeComponentBase
@using Hmi.Services.Shell

<nav class="rail" aria-label="Displays">
    @foreach (var group in DisplayCatalog.For(Session.Mode).GroupBy(e => e.Group).OrderBy(g => Array.IndexOf(DisplayEntry.GroupOrder, g.Key)))
    {
        @if (group.Key == DisplayEntry.AdministrationGroup)
        {
            <AuthorizeView Policy="Administrator">
                <p class="rail-group" title="@group.Key">@group.Key</p>
                @foreach (var entry in group)
                {
                    @Link(entry)
                }
            </AuthorizeView>
        }
        else
        {
            <p class="rail-group" title="@group.Key">@group.Key</p>
            @foreach (var entry in group)
            {
                @Link(entry)
            }
        }
    }
</nav>

@code {
    protected override bool Refresh() => true;

    private static NavLinkMatch MatchFor(DisplayEntry entry) => entry.Href is "" or "grid" ? NavLinkMatch.All : NavLinkMatch.Prefix;

    private RenderFragment Link(DisplayEntry entry) => @<NavLink href="@entry.Href" Match="@MatchFor(entry)" class="rail-item" title="@entry.Title" aria-label="@entry.Title">@Icon(entry.Icon)<span class="rail-label">@entry.Title</span></NavLink>;

