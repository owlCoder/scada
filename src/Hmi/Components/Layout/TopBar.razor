@inherits RealtimeComponentBase
@inject Application.Simulation.SimulationEngine Engine

<header class="topbar">
    <span class="pill">@(_paused ? "Simulation paused" : "Simulation running")</span>
    <span class="muted">Sim time @_simTime.ToString(@"hh\:mm\:ss", CultureInfo.InvariantCulture)</span>
    <a class="pill @(_activeAlarms > 0 ? "pill-alarm" : "pill-neutral")" href="@AlarmPath">@_activeAlarms active alarm(s)</a>
    <span class="spacer"></span>
    <span class="muted">@Session.Actor.Name · @Session.Actor.Role</span>
    <form method="post" action="/account/mode" data-enhance="false" class="mode-switch">
        <AntiforgeryToken />
        <button type="submit" class="btn">Switch to @(Session.Mode == Application.Common.SimulationMode.Grid ? "Water treatment plant" : "Electrical distribution grid")</button>
    </form>
    <div class="alarm-banner" role="status" aria-live="polite">
        @if (_newest.Length == 0)
        {
            <span class="muted">No unacknowledged alarms</span>
        }
        @foreach (var alarm in _newest)
        {
            <a href="@AlarmPath">@alarm</a>
        }
    </div>
</header>

@code {
    private bool _paused;
    private TimeSpan _simTime;
    private int _activeAlarms;
    private string[] _newest = [];
    private string AlarmPath => Session.Mode == Application.Common.SimulationMode.Grid ? "/grid/alarms" : "/alarms";

    protected override IReadOnlyCollection<string> Topics =>
        [RealtimeTopics.Simulation, RealtimeTopics.Plant, RealtimeTopics.Alarms, RealtimeTopics.Grid, RealtimeTopics.GridAlarms, RealtimeTopics.GridStatus];

    protected override bool Refresh()
    {
        if (Session.Mode == Application.Common.SimulationMode.Grid)
        {
            if (Session.GridView is not { } grid)
                return true;
            _paused = grid.Status.Paused;
            _simTime = grid.Status.SimulationTime;
            var alarms = Session.GridSnapshot().Alarms;
            _activeAlarms = alarms.Count(a => a.Active);
            _newest = alarms.Where(a => !a.Acknowledged).OrderByDescending(a => a.RaisedAt).Take(3)
                .Select(a => $"{a.Severity} · {a.SourceId} · {a.Message}").ToArray();
        }
        else
        {
            _paused = Engine.Status.IsPaused;
            _simTime = Engine.Status.SimulationTime;
            var alarms = Session.Plant().Alarms;
            _activeAlarms = alarms.Count(a => a.IsActive);
            _newest = alarms.Where(a => !a.IsAcknowledged).OrderByDescending(a => a.RaisedAt).Take(3)
                .Select(a => $"{a.Severity} · {a.SourceId} · {a.Message}").ToArray();
        }
        return true;
    }
}
