@inherits RealtimeComponentBase

<nav class="nav" aria-label="Main">
    <div class="brand">SCADA <span>training plant</span></div>
    @if (Session.Mode == Application.Common.SimulationMode.Grid)
    {
        <NavLink href="grid" Match="NavLinkMatch.All">Grid overview</NavLink>
        <NavLink href="grid/diagram">Single-line diagram</NavLink>
        <p class="nav-group">Network</p>
        @foreach (var page in new[] { "feeders", "transformers", "switches", "loads", "protection", "measurements", "alarms" })
        {
            <NavLink href="@($"grid/{page}")">@(char.ToUpperInvariant(page[0]) + page[1..])</NavLink>
        }
        <AuthorizeView Policy="Administrator">
            <NavLink href="grid/instructor">Grid instructor</NavLink>
            <NavLink href="grid/editor">Network editor</NavLink>
            <NavLink href="grid/rules">Detection rules</NavLink>
        </AuthorizeView>
    }
    else
    {
    <NavLink href="" Match="NavLinkMatch.All">Overview</NavLink>
    <NavLink href="diagram">Plant diagram</NavLink>
    <p class="nav-group">Process</p>
    <NavLink href="tanks">Tanks</NavLink>
    <NavLink href="pumps">Pumps</NavLink>
    <NavLink href="valves">Valves</NavLink>
    <NavLink href="sensors">Sensors</NavLink>
    <NavLink href="controllers">PLC / RTU</NavLink>
    <NavLink href="trends">Trends</NavLink>
    <p class="nav-group">Operations</p>
    <NavLink href="alarms">Alarms</NavLink>
    }
    <NavLink href="events">Events</NavLink>
    <NavLink href="incidents">Incidents</NavLink>
    <NavLink href="@(Session.Mode == Application.Common.SimulationMode.Grid ? "grid/scenarios" : "scenarios")">Scenarios</NavLink>
    <p class="nav-group">System</p>
    @if (Session.Mode == Application.Common.SimulationMode.Water)
    {
    <NavLink href="communications">Communications</NavLink>
    <NavLink href="registers">Registers</NavLink>
    }
    <NavLink href="health">System health</NavLink>
    <NavLink href="identity">My account</NavLink>
    <AuthorizeView Policy="Administrator">
        <NavLink href="accounts">Accounts &amp; rules</NavLink>
    </AuthorizeView>
</nav>

@code {
    protected override bool Refresh() => true;
}
