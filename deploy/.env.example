# Copy to deploy/.env and replace every placeholder with a distinct random value (openssl rand -hex 32).
POSTGRES_PASSWORD=replace-with-random-postgres-password
SCADA_VIEWER_KEY=replace-with-random-viewer-key
SCADA_OPERATOR_KEY=replace-with-random-operator-key
SCADA_ADMIN_KEY=replace-with-random-admin-key
SCADA_IMAGE=scada-api:local
SCADA_HTTP_PORT=5080
POSTGRES_PORT=5432
# To publish a protocol, enable it AND add its compose.opcua.yaml / compose.modbus.yaml override.
SCADA_OPCUA_ENABLED=false
SCADA_OPCUA_PORT=4840
SCADA_MODBUS_ENABLED=false
SCADA_MODBUS_PORT=1502
# Optional observability profile / compose.keycloak.yaml overlay.
SCADA_OTLP_ENDPOINT=
SCADA_OIDC_ENABLED=false
SCADA_OIDC_CLIENT_SECRET=replace-with-random-oidc-client-secret
KEYCLOAK_ADMIN_PASSWORD=replace-with-random-keycloak-password
